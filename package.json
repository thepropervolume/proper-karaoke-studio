{
  "name": "proper-karaoke-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "The Proper Volume Karaoke Studio — create karaoke videos and TPV kits from audio stems and timed lyrics.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "package:win": "npm run build && electron-builder --win nsis zip",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.thepropervolume.karaokestudio",
    "productName": "The Proper Volume Karaoke Studio",
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "extraResources": [{ "from": "scripts/align_lyrics.py", "to": "scripts/align_lyrics.py" }],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "deb"] },
    "mac": { "target": ["dmg", "zip"] }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "saxes": "6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "wait-on": "^8.0.0"
  }
}
