{
  "name": "proper-karaoke-studio",
  "version": "0.11.2",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "author": {
    "name": "The Proper Volume",
    "email": "hello@thepropervolume.com"
  },
  "homepage": "https://release.thepropervolume.com/studio",
  "description": "The Proper Volume Karaoke Studio — create karaoke videos and TPV kits from audio stems and timed lyrics.",
  "main": "dist-electron/main.cjs",
  "bin": {
    "tpv-karaoke-studio": "dist-electron/cli.cjs",
    "tpv-studio": "dist-electron/cli.cjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "cli": "node dist-electron/cli.cjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "package:win": "npm run build && node scripts/windows/build-cli.mjs && electron-builder --win nsis zip",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.thepropervolume.karaokestudio",
    "productName": "The Proper Volume Karaoke Studio",
    "files": [
      "dist/**",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/licenses",
        "to": "licenses"
      },
      {
        "from": "scripts/align_lyrics.py",
        "to": "scripts/align_lyrics.py"
      },
      {
        "from": "dist-electron/cli.cjs",
        "to": "studio-cli.cjs"
      },
      {
        "from": "public/lyric-fonts",
        "to": "lyric-fonts"
      },
      {
        "from": "assets/branding",
        "to": "branding",
        "filter": [
          "app.ico",
          "app.png"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/branding/app.ico",
      "extraFiles": [
        {
          "from": "dist-electron/windows-cli/tpv-karaoke-studio.exe",
          "to": "cli/tpv-karaoke-studio.exe"
        }
      ],
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/windows/installer.nsh",
      "installerIcon": "assets/branding/app.ico",
      "uninstallerIcon": "assets/branding/app.ico",
      "installerHeaderIcon": "assets/branding/app.ico"
    },
    "linux": {
      "icon": "assets/branding/linux",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "fpm": [
        "scripts/linux/tpv-karaoke-studio=/usr/bin/tpv-karaoke-studio"
      ]
    },
    "mac": {
      "icon": "assets/branding/app.icns",
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Studio records voice stems when you start a microphone take."
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@thepropervolume/karaoke-core": "file:vendor/thepropervolume-karaoke-core-0.1.1.tgz",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "saxes": "6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "wait-on": "^8.0.0"
  }
}
